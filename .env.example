# TiflToys — environment variables
# Copy to `.env.local` and fill in real values. These are SERVER-ONLY: the
# Shopify token is never exposed to the browser (reads run in Server Components
# / Server Actions via src/lib/shopify.ts). Do NOT prefix with NEXT_PUBLIC_.

# Your Shopify *.myshopify.com domain (not the custom domain), e.g. xgmq1a-uw.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (Shopify admin → Settings → Apps → Develop apps → Storefront API)
SHOPIFY_STOREFRONT_TOKEN=

# Public canonical site URL — used for metadataBase, sitemap, robots, OG tags.
# Defaults to https://tifltoys.com if unset.
NEXT_PUBLIC_SITE_URL=https://tifltoys.com

# Contact form delivery (M4).
# DEFAULT: Web3Forms. Get a free access key at https://web3forms.com (just
# confirm your email — no account). Submissions are emailed to that inbox.
# If unset, the form logs server-side and still shows success (dev-safe).
WEB3FORMS_ACCESS_KEY=

# OPTIONAL: send via Resend instead (used only if WEB3FORMS_ACCESS_KEY is empty
# and all three of these are set). Requires verifying a sending domain in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
